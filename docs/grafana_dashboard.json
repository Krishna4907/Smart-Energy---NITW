{
  "__inputs": [
    {
      "name": "DS_INFINITY",
      "label": "Infinity",
      "description": "Infinity datasource pointing at the inference server",
      "type": "datasource",
      "pluginId": "yesoreyeram-infinity-datasource",
      "pluginName": "Infinity"
    }
  ],
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "refresh": "15s",
  "schemaVersion": 38,
  "tags": ["nilm", "energy"],
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "title": "Smart Energy Monitor (NILM)",
  "uid": "smart-energy-nilm",
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "server",
        "label": "Server URL",
        "type": "textbox",
        "query": "http://localhost:5000",
        "current": { "text": "http://localhost:5000", "value": "http://localhost:5000" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Power (W)",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "${DS_INFINITY}" },
      "fieldConfig": { "defaults": { "unit": "watt", "color": { "mode": "thresholds" } } },
      "targets": [ {
        "refId": "A", "type": "json", "source": "url", "format": "table",
        "url": "${server}/status", "url_options": { "method": "GET" },
        "root_selector": "",
        "columns": [ { "selector": "total_power_w", "text": "W", "type": "number" } ]
      } ]
    },
    {
      "id": 2,
      "title": "Current (A)",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "${DS_INFINITY}" },
      "fieldConfig": { "defaults": { "unit": "amp" } },
      "targets": [ {
        "refId": "A", "type": "json", "source": "url", "format": "table",
        "url": "${server}/status", "url_options": { "method": "GET" },
        "columns": [ { "selector": "total_current_a", "text": "A", "type": "number" } ]
      } ]
    },
    {
      "id": 3,
      "title": "Voltage (V)",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "${DS_INFINITY}" },
      "fieldConfig": { "defaults": { "unit": "volt" } },
      "targets": [ {
        "refId": "A", "type": "json", "source": "url", "format": "table",
        "url": "${server}/status", "url_options": { "method": "GET" },
        "columns": [ { "selector": "voltage_v", "text": "V", "type": "number" } ]
      } ]
    },
    {
      "id": 4,
      "title": "Appliances ON",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "${DS_INFINITY}" },
      "targets": [ {
        "refId": "A", "type": "json", "source": "url", "format": "table",
        "url": "${server}/status", "url_options": { "method": "GET" },
        "root_selector": "breakdown",
        "columns": [ { "selector": "name", "text": "name", "type": "string" } ]
      } ],
      "options": { "reduceOptions": { "calcs": ["count"] } }
    },
    {
      "id": 5,
      "title": "Energy today (kWh)",
      "type": "stat",
      "gridPos": { "h": 5, "w": 12, "x": 0, "y": 5 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "${DS_INFINITY}" },
      "fieldConfig": { "defaults": { "unit": "kwatth", "decimals": 4 } },
      "targets": [ {
        "refId": "A", "type": "json", "source": "url", "format": "table",
        "url": "${server}/status", "url_options": { "method": "GET" },
        "columns": [ { "selector": "total_energy_kwh", "text": "kWh", "type": "number" } ]
      } ]
    },
    {
      "id": 6,
      "title": "Electricity bill (Rs)",
      "type": "stat",
      "gridPos": { "h": 5, "w": 12, "x": 12, "y": 5 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "${DS_INFINITY}" },
      "fieldConfig": { "defaults": { "unit": "currencyINR", "decimals": 3 } },
      "targets": [ {
        "refId": "A", "type": "json", "source": "url", "format": "table",
        "url": "${server}/status", "url_options": { "method": "GET" },
        "columns": [ { "selector": "total_cost_rs", "text": "Rs", "type": "number" } ]
      } ]
    },
    {
      "id": 7,
      "title": "Per-appliance breakdown",
      "type": "table",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 10 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "${DS_INFINITY}" },
      "targets": [ {
        "refId": "A", "type": "json", "source": "url", "format": "table",
        "url": "${server}/status", "url_options": { "method": "GET" },
        "root_selector": "breakdown",
        "columns": [
          { "selector": "name", "text": "Appliance", "type": "string" },
          { "selector": "watts", "text": "Watts", "type": "number" },
          { "selector": "amps", "text": "Amps", "type": "number" },
          { "selector": "energy_kwh", "text": "kWh", "type": "number" },
          { "selector": "cost_rs", "text": "Cost (Rs)", "type": "number" }
        ]
      } ]
    }
  ]
}
